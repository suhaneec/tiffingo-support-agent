# Example of the Secrets to paste into Streamlit Community Cloud
# (App > Settings > Secrets). Never put real values in this example file.
GOOGLE_API_KEY = "paste-your-key-here"
GEMINI_MODEL = "gemini-3.5-flash-lite"
OTP_EMAIL_ADDRESS = "your-gmail-address@gmail.com"
OTP_EMAIL_APP_PASSWORD = "paste-your-16-letter-app-password"
